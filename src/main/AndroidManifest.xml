<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Debug-only activity entry; actual enablement is controlled from the app module -->
        <activity
            android:name="com.mousa.networkinspector.ui.NetworkInspectorActivity"
            android:exported="false" />

        <!-- FileProvider for sharing exported network log files.
             Uses a subclass so it doesn't conflict with the host app's FileProvider. -->
        <provider
            android:name="com.mousa.networkinspector.NetworkInspectorFileProvider"
            android:authorities="${applicationId}.networkinspector.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/network_inspector_file_paths" />
        </provider>
    </application>

</manifest>

